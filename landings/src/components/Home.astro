---
/**
 * The home page body. Structure only; words come from i18n/copy/<locale>.ts.
 *
 * This is the reason the copy layer exists: the prose here is threaded through
 * the markup, so forking this file per locale would mean maintaining N copies
 * of the layout to change N copies of the words.
 */
import RiverDemo from './RiverDemo.astro';
import { localeHref, type LangCode } from '../i18n/languages';
import { getCopy } from '../i18n/copy';

interface Props {
  locale: LangCode;
}
const { locale } = Astro.props;
const copy = getCopy(locale);
---

<!-- Hero: the question, on the left bank -->
<section class="hero">
  <div class="container">
    <div class="hero-inner">
      <h1>
        {copy.site.headline}{' '}
        <span class="accent">{copy.site.headlineAccent}</span>
      </h1>
      <p class="lede">{copy.site.lede}</p>

      <div class="cta-row">
        <a class="btn btn-primary" href="/login">{copy.site.ctaPrimary}</a>
        <a class="btn btn-secondary" href={localeHref(locale, '/vision')}>
          {copy.site.ctaSecondary}
        </a>
      </div>

      <p class="microcopy">{copy.site.microcopy}</p>
    </div>
  </div>
</section>

<!-- The river — the signature demo flows straight out of the hero -->
<RiverDemo locale={locale} />

<!-- Why a graph -->
<section id="why-a-graph" class="section soft">
  <div class="container">
    <div class="text-center section-head">
      <p class="eyebrow">{copy.problem.eyebrow}</p>
      <h2>{copy.problem.title}</h2>
    </div>
    <div class="problem-prose">
      {copy.problem.paragraphs.map((p) => <p>{p}</p>)}
    </div>
    <div class="grid grid-2 contrast">
      <div class="contrast-tile contrast-tree">
        <h3>{copy.problem.tree.title}</h3>
        <p>{copy.problem.tree.text}</p>
      </div>
      <div class="contrast-tile contrast-graph">
        <h3>{copy.problem.graph.title}</h3>
        <p>{copy.problem.graph.text}</p>
      </div>
    </div>
  </div>
</section>

<!-- How it works: a real sequence, so the numbering carries meaning -->
<section id="how-it-works" class="section">
  <div class="container">
    <div class="text-center section-head">
      <p class="eyebrow">{copy.howItWorks.eyebrow}</p>
      <h2>{copy.howItWorks.title}</h2>
    </div>
    <ol class="steps">
      {
        copy.howItWorks.steps.map((s) => (
          <li class="step">
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<!-- Principles -->
<section id="principles" class="section soft">
  <div class="container">
    <div class="text-center section-head">
      <p class="eyebrow">{copy.principles.eyebrow}</p>
      <h2>{copy.principles.title}</h2>
    </div>
    <div class="quotes">
      {copy.principles.quotes.map((q) => <blockquote>{q}</blockquote>)}
    </div>
  </div>
</section>

<!-- Final CTA -->
<section class="section cta-band">
  <div class="container text-center">
    <h2>{copy.ctaBand.title}</h2>
    <p>{copy.ctaBand.text}</p>
    <a class="btn btn-primary" href="/login">{copy.ctaBand.cta}</a>
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(180deg, var(--brand-bg) 0%, var(--brand-hero-1) 100%);
    padding-block: var(--space-5) var(--space-3);
  }
  .hero-inner {
    max-width: 720px;
  }
  .hero h1 {
    font-size: clamp(2rem, 5.4vw, 3.2rem);
  }
  .hero .accent {
    color: var(--color-accent-strong);
    font-style: italic;
  }
  .lede {
    font-size: 1.12rem;
    max-width: 58ch;
    color: var(--brand-ink);
    opacity: 0.85;
  }
  .cta-row {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-top: var(--space-3);
  }
  .microcopy {
    margin-top: var(--space-2);
    margin-bottom: 0;
    font-size: 0.9rem;
    font-family: var(--brand-font-display);
    font-style: italic;
    color: var(--color-text-muted);
  }

  .problem-prose {
    max-width: 640px;
    margin-inline: auto;
    margin-bottom: var(--space-3);
  }

  .contrast {
    max-width: 840px;
    margin-inline: auto;
  }
  .contrast-tile {
    border-radius: var(--brand-radius);
    padding: var(--space-3);
    background: var(--brand-surface);
    border: 1px solid var(--brand-border);
  }
  .contrast-tile h3 {
    font-size: 1.05rem;
  }
  .contrast-tile p {
    margin-bottom: 0;
    font-size: 0.95rem;
  }
  .contrast-tree {
    border-style: dashed;
  }
  .contrast-graph {
    border-color: var(--brand-primary);
    box-shadow: var(--brand-shadow);
  }

  .steps {
    list-style: none;
    counter-reset: step;
    padding: 0;
    margin: 0 auto;
    max-width: 720px;
    display: grid;
    gap: var(--space-3);
  }
  .step {
    counter-increment: step;
    position: relative;
    padding-left: 4rem;
  }
  .step::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0;
    width: 2.6rem;
    height: 2.6rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--brand-hero-2);
    color: var(--brand-primary-strong);
    font-family: var(--brand-font-display);
    font-weight: 700;
    font-size: 1.2rem;
  }
  .step h3 {
    font-size: 1.1rem;
    margin-bottom: 0.4rem;
  }
  .step p {
    margin-bottom: 0;
  }

  .quotes {
    max-width: 680px;
    margin-inline: auto;
    display: grid;
    gap: var(--space-2);
  }
  .quotes blockquote {
    margin: 0;
    padding: var(--space-2) var(--space-3);
    border-left: 3px solid var(--brand-gold);
    background: var(--brand-surface);
    border-radius: 0 var(--brand-radius) var(--brand-radius) 0;
    font-family: var(--brand-font-display);
    font-style: italic;
    font-size: 1.08rem;
    color: var(--brand-ink);
  }

  .cta-band {
    background: linear-gradient(180deg, var(--brand-bg) 0%, var(--brand-hero-2) 100%);
  }
  .cta-band .btn {
    margin-top: var(--space-1);
  }
</style>
