{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prioritarius",
  "compatibility_date": "2026-06-23",
  "workers_dev": true,
  // Assets-only: NO Worker script. Every request is answered by Cloudflare
  // static assets (free, never billed against the Workers request quota).
  // A path with a file gets that file; any other path gets the app SPA shell
  // dist/index.html (200, URL kept), so the app's routes need no list here.
  // public/_redirects rewrites exactly `/` to the landing home
  // (dist/landing.html) and holds the legacy 301s.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Hosts are attached as Cloudflare Custom Domains / zone routes (unchanged).
  // Attaching a custom domain needs a token with Zone:DNS:Edit (done once in
  // the dashboard). Firebase Auth's /__/* is NOT served here: where a site needs
  // it, a zone route sends it to the shared sneat-firebase-auth-proxy Worker
  // (sneat-sites repo). www -> apex, where wanted, is a zone Redirect Rule.
  "routes": [
    { "pattern": "prioritarius.com", "custom_domain": true }
  ]
}
